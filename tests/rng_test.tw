mode systems

import "harness.tw" as t
import "../src/rng.tw" as rng

fn an_epoch_seed_depends_only_on_the_base_and_the_epoch() {
  t.equal_i64("epoch 8 under seed 1 is stable",
    rng.epoch_seed(1, 8), rng.epoch_seed(1, 8))
  t.check("epoch 8 and epoch 9 differ", rng.epoch_seed(1, 8) != rng.epoch_seed(1, 9))
  t.check("two base seeds differ at the same epoch",
    rng.epoch_seed(1, 8) != rng.epoch_seed(2, 8))
}

fn the_mixer_separates_inputs_that_are_close_together() {
  # This used to pin loom's splitmix64 finaliser against a Python transcription
  # of Vigna's reference. The finaliser is gone: it is three 64-bit multiplies
  # and an I64 here holds 53 bits, so every multiply overflowed into the
  # rounding and the mixer returned the same saturated value for every input --
  # deterministic, plausible, and the same seed for every epoch. The mixer is
  # SHA-256 now (twill's std/hash), so there is no reference stream of loom's
  # own to pin, and what is checked instead is the property the derivation
  # exists for: inputs that are adjacent must not land near each other.
  t.check("mix separates 0 and 1", rng.mix(0) != rng.mix(1))
  t.check("mix separates 1 and 2", rng.mix(1) != rng.mix(2))
  t.check("mix separates a negative from its magnitude", rng.mix(-1) != rng.mix(1))
  t.check("mix is deterministic", rng.mix(12345) == rng.mix(12345))

  # The failure the old mixer actually had: every input collapsing onto one
  # value. Sixty-four adjacent inputs must give sixty-four distinct seeds.
  let seen: Dict[Str, I64] = {}
  let i: I64 = 0
  while i < 64 {
    seen[str(rng.mix(i))] = 1
    i = i + 1
  }
  t.equal_i64("sixty-four adjacent inputs give distinct seeds", len(dict_keys(seen)), 64)
}

fn a_seed_stream_is_distinct_and_reproducible() {
  # Same property, over the two derivations a run actually uses. An epoch seed
  # has to be reproducible from (base, epoch) alone -- that is what makes a
  # resumed run match an uninterrupted one -- and distinct across both.
  t.equal_i64("an epoch seed is reproducible", rng.epoch_seed(1, 8), rng.epoch_seed(1, 8))
  t.check("epochs differ", rng.epoch_seed(1, 8) != rng.epoch_seed(1, 9))
  t.check("bases differ", rng.epoch_seed(1, 8) != rng.epoch_seed(2, 8))
  t.check("a negative base still separates", rng.epoch_seed(-7919, 3) != rng.epoch_seed(-7919, 4))

  t.equal_i64("a derived seed is reproducible", rng.derive(5, "init"), rng.derive(5, "init"))
  t.check("tags separate", rng.derive(5, "init") != rng.derive(5, "split"))
  t.check("bases separate under one tag", rng.derive(5, "init") != rng.derive(6, "init"))

  # A derived seed and an epoch seed from the same base must not collide, which
  # is the whole reason `derive` takes a tag.
  t.check("a tag does not collide with an epoch", rng.derive(0, "init") != rng.epoch_seed(0, 0))
}

fn an_epoch_seed_is_never_negative() {
  # seed() takes a non-negative value and the mix spans the signed range, so
  # this is the property the masking in epoch_seed exists to hold.
  let e = 0
  while e < 64 {
    t.check("epoch seed " + str(e) + " is non-negative", rng.epoch_seed(-7919, e) >= 0)
    e = e + 1
  }
}

fn consecutive_epochs_do_not_produce_adjacent_seeds() {
  # The failure this guards against is base + epoch fed straight to a
  # generator, where neighbouring epochs draw correlated streams. A weak but
  # cheap check: the seeds should differ in their low bits, not only their
  # high ones.
  let a = rng.epoch_seed(1000, 3)
  let b = rng.epoch_seed(1000, 4)
  let d = a - b
  if d < 0 {
    d = -d
  }
  t.check("neighbouring epoch seeds are far apart", d > 1000000)
}

fn a_derived_seed_separates_purposes() {
  t.check("init and split do not share a stream",
    rng.derive(5, "init") != rng.derive(5, "split"))
  t.equal_i64("a derived seed is stable", rng.derive(5, "init"), rng.derive(5, "init"))
  t.check("a derived seed is non-negative", rng.derive(-1, "augment") >= 0)
}

fn a_derived_seed_is_not_an_epoch_seed() {
  t.check("derive and epoch_seed do not collide",
    rng.derive(9, "init") != rng.epoch_seed(9, 0))
}

the_mixer_separates_inputs_that_are_close_together()
a_seed_stream_is_distinct_and_reproducible()
an_epoch_seed_depends_only_on_the_base_and_the_epoch()
an_epoch_seed_is_never_negative()
consecutive_epochs_do_not_produce_adjacent_seeds()
a_derived_seed_separates_purposes()
a_derived_seed_is_not_an_epoch_seed()
t.report("rng")
