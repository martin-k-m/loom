mode systems

# report.tw: the lines a run prints.
#
# These are single-line, and now they are lit. twill's terminal layer became
# reachable from a package once its modules began importing each other by a path
# relative to the importer, so this file vendors it the same way weft and bobbin
# do, rather than reimplementing it. Capabilities are detected once per line and
# every escape goes through ansi.paint, which drops to plain text the moment the
# output is piped or the terminal cannot colour, so a redirected log is still
# the same bare columns it always was.
#
# What is lit and why: the loss value, because it is the number a person's eye
# tracks down the column, and the bar's fill, because a bar that is one colour
# with its track is harder to read at a glance than one that is two. The labels
# stay quiet so the values carry the line. This is still a per-epoch line and
# not the stateful bar with a rate and an ETA from src/cli/progress.tw; adopting
# that means threading a clock through the trainer, which is its own change.

import "state.tw" as st
import "metrics.tw" as met
import "std/term/caps" as cp
import "std/term/ansi" as ansi
import "std/term/theme" as th
import "std/json" as json

# A fixed-width decimal. `str` on an F64 prints a shortest round-trip form,
# which is right for a value being read back and wrong for a column of losses,
# where varying width makes the column unreadable and small changes invisible.
fn fixed(x: F64, places: I64) -> Str {
  let neg = x < 0.0
  let v = x
  if neg {
    v = -v
  }
  let scale = 1.0
  let i = 0
  while i < places {
    scale = scale * 10.0
    i = i + 1
  }
  let whole = i64(v)
  let frac = i64((v - f64(whole)) * scale + 0.5)
  # Rounding the fraction can carry into the integer part. Without this, 0.9996
  # to three places prints "0.1000".
  if f64(frac) >= scale {
    frac = 0
    whole = whole + 1
  }
  let out = str(whole) + "." + pad_left_zero(str(frac), places)
  if neg {
    return "-" + out
  }
  out
}

fn pad_left_zero(s: Str, width: I64) -> Str {
  let out = s
  while len(out) < width {
    out = "0" + out
  }
  out
}

fn pad_right(s: Str, width: I64) -> Str {
  let out = s
  while len(out) < width {
    out = out + " "
  }
  out
}

fn pad_left(s: Str, width: I64) -> Str {
  let out = s
  while len(out) < width {
    out = " " + out
  }
  out
}

# "epoch  7/20" with the numbers right-aligned against the total, so the column
# does not shift when the epoch count crosses a power of ten.
fn epoch_label(epoch: I64, epochs: I64) -> Str {
  let total = str(epochs)
  "epoch " + pad_left(str(epoch), len(total)) + "/" + total
}

# The per-epoch line. Validation metrics are appended in the order they were
# first recorded, which src/metrics.tw fixes, so the columns are the same on
# every line of a run and diffing two runs' logs lines up.
fn epoch_line(s: st.State, caps: cp.Caps) -> Str {
  let out = ansi.paint(caps, th.muted(), epoch_label(s.epoch, s.epochs))
    + ansi.paint(caps, th.muted(), "  loss ")
    + ansi.paint(caps, th.code(), fixed(s.train_loss, 4))
    + ansi.paint(caps, th.muted(), "  lr ")
    + ansi.paint(caps, th.code(), fixed(s.lr, 6))
  let i = 0
  while i < len(s.val.names) {
    let name = s.val.names[i]
    out = out + ansi.paint(caps, th.muted(), "  val_" + name + " ")
      + ansi.paint(caps, th.code(), fixed(met.value_named(s.val, name), 4))
    i = i + 1
  }
  out
}

# One JSON object per line. Machine-readable output is a separate function
# rather than a flag on the human one, because a format that is sometimes
# parseable is a format nothing parses.
#
# Built through std/json rather than concatenated. Three things that buys, in
# the order they matter:
#
# - The metric name is escaped. It was interpolated straight into a quoted
#   string here, so a metric registered as `f1"score` emitted a line no parser
#   would accept, and the run that produced it looked fine until something read
#   the log. Nothing in loom names a metric that way, and nothing in loom
#   controls what a caller names one.
# - The render walks a Bytes, so the document is built in linear time instead of
#   copying the whole prefix per field. A per-epoch line is small enough that
#   this is not why the change was made, and it is still the right shape.
# - Field order is insertion order, which std/json guarantees, so the columns
#   are the same on every line of a run and diffing two runs' logs lines up.
#   That was the property the hand-rolled version had by construction and it is
#   the one a Dict could quietly have taken away.
fn epoch_json(s: st.State) -> Str {
  let doc = json.object()
  json.set_field(doc, "epoch", json.number(f64(s.epoch)))
  json.set_field(doc, "epochs", json.number(f64(s.epochs)))
  json.set_field(doc, "global_step", json.number(f64(s.global_step)))
  json.set_field(doc, "lr", json.number(s.lr))
  json.set_field(doc, "train_loss", json.number(s.train_loss))
  let i = 0
  while i < len(s.val.names) {
    let name = s.val.names[i]
    json.set_field(doc, "val_" + name, json.number(met.value_named(s.val, name)))
    i = i + 1
  }
  json.render(doc)
}

# A textual progress indication, printed once per epoch. It is a fill without a
# time estimate, and the estimate is the part that would actually help. See the
# note at the top of this file for why it is not here.
fn bar(done: I64, total: I64, width: I64, caps: cp.Caps) -> Str {
  if total <= 0 {
    return ansi.paint(caps, th.muted(), "[" + pad_right("", width) + "]")
  }
  let filled = done * width // total
  # A solid block reads as a fill where the terminal can draw it; the ASCII
  # hash is the same shape in a font that cannot. The fill is mint, twill's
  # colour for progress and structure, and the track is left quiet behind it.
  let fill_glyph = if caps.unicode { "█" } else { "#" }
  let track_glyph = if caps.unicode { "─" } else { "." }
  let fill = ""
  let i = 0
  while i < filled {
    fill = fill + fill_glyph
    i = i + 1
  }
  let track = ""
  while i < width {
    track = track + track_glyph
    i = i + 1
  }
  ansi.paint(caps, th.muted(), "[")
    + ansi.paint(caps, th.success(), fill)
    + ansi.paint(caps, th.muted(), track)
    + ansi.paint(caps, th.muted(), "]")
}
